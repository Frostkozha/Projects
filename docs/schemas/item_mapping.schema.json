  "properties": {
    "item_id": {
      "title": "Item Id",
      "type": "string"
    },
    "item_version": {
      "title": "Item Version",
      "type": "string"
    },
    "approved": {
      "title": "Approved",
      "type": "boolean"
    },
    "evidence_sets": {
      "items": {
        "$ref": "#/$defs/EvidenceSet"
      },
      "title": "Evidence Sets",
      "type": "array"
    }
  },
  "required": [
    "item_id",
    "item_version",
    "approved",
    "evidence_sets"
  ],
  "title": "ItemMapping",
  "type": "object"
