          "items": {
            "type": "string"
          },
          "title": "Passage Ids",
          "type": "array"
        },
        "coverage": {
          "default": "full",
          "enum": [
            "full",
            "partial"
          ],
          "title": "Coverage",
          "type": "string"
        }
      },
      "required": [
        "passage_ids"
      ],
      "title": "EvidenceSet",
      "type": "object"
    }
  },
  "additionalProperties": false,
